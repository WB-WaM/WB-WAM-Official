# Copy to bridge/.env. Paths are relative to the repository root unless absolute.
# Download with scripts/download_models.py; config.yaml and dataset_stats.json stay beside the weights.
WBWAM_BRIDGE_CHECKPOINT_PATH=training/checkpoints/wbwam/midtrain/step_020560.pt
# Download the SONIC release separately as shown in docs/agent_setup.md.
WBWAM_BRIDGE_ENCODER_MODEL=checkpoints/sonic_release/model_encoder.onnx
WBWAM_BRIDGE_TEXT_CACHE_DIR=checkpoints/text_embeds

# Replace the robot endpoint and camera ID for your hardware.
WBWAM_BRIDGE_CAMERA_ENDPOINT=tcp://ROBOT_IP:5560
WBWAM_BRIDGE_CAMERA_KEY=YOUR_CAMERA_KEY
WBWAM_BRIDGE_STATE_ACTION_ENDPOINT=tcp://127.0.0.1:5558
WBWAM_BRIDGE_HAND_STATUS_ENDPOINT=tcp://ROBOT_IP:5559
