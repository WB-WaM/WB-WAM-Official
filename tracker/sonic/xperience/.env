# Xperience-10M streaming download + conversion config.
# Put the real HF token here on the server. Do not commit a filled token.

RUN_SAMPLE=false
HF_TOKEN=
HF_REVISION=main

# Large-data storage. RAW_ROOT is treated as a temporary staging area and can be
# cleaned episode-by-episode after conversion.
XPERIENCE_DATA_ROOT=/gpfs/${USER}/xperience_data
RAW_ROOT=${XPERIENCE_DATA_ROOT}/raw_stream
PROCESSED_ROOT=${XPERIENCE_DATA_ROOT}/processed
QUEUE_DIR=${XPERIENCE_DATA_ROOT}/queue
LOG_DIR=${XPERIENCE_DATA_ROOT}/logs

# Stop before the target filesystem gets too full.
MIN_FREE_GB=500
MAX_EPISODES=

# Streaming behavior. With the defaults, one episode can be processed while the
# next one is downloading, keeping raw storage bounded.
PROCESS_WORKERS=1
PREFETCH_EPISODES=1
QUEUE_WAIT_S=5
SLEEP_S=0
DELETE_RAW_AFTER_PARSE=true
OVERWRITE=false

# Output/video settings.
RESIZE_VIDEOS=true
KEEP_INTERMEDIATE=false

# Python used by the main pipeline. PIPELINE_PYTHONPATH is useful on this
# machine for the local onnxruntime dependency shim.
PIPELINE_PYTHON=python
PIPELINE_PYTHONPATH=/tmp/xperience_ort_nodeps

# GMR retargeting. Fill GMR_ROOT or SMPLX_FOLDER if your server needs explicit
# body-model paths. GMR_PYTHON should be an env that can import
# general_motion_retargeting.
REQUIRE_GMR=true
GMR_PYTHON=/home/yebj/anaconda3/envs/gmr/bin/python
GMR_ROOT=
SMPLX_FOLDER=
GMR_ROBOT=unitree_g1

# WUJI hand retargeting.
REQUIRE_WUJI=true
WUJI_ROOT=/home/yebj/zhust/wuji-retargeting
WUJI_PYTHON=/home/yebj/anaconda3/envs/sonic/bin/python
WUJI_LEFT_CONFIG=/home/yebj/zhust/wuji-retargeting/example/config/retarget_manus_left.yaml
WUJI_RIGHT_CONFIG=/home/yebj/zhust/wuji-retargeting/example/config/retarget_manus_right.yaml

# SONIC action-token encoder.
ENCODER_MODEL=/home/yebj/zhust/GR00T-WholeBodyControl/gear_sonic_deploy/policy/release/model_encoder.onnx
