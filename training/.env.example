# Copy to .env and edit for your machine. Relative paths use training/ as base.
# Existing environment variables take precedence. No credentials are needed here.
WB_WAM_DATA_ROOT=./data
WB_WAM_PICO_ROOT=${WB_WAM_DATA_ROOT}/pico_archive
WB_WAM_REAL_ROOT=${WB_WAM_DATA_ROOT}/real_archive
# Official HumanoidArena v3.1 SONIC subdataset; download as in the README.
WBWAM_ARENA_NATIVE50_ROOT=./data/humanoid_arena/HumanoidArena_merged_datasets_v3_1/sonic_8_refpose_v3_1

DIFFSYNTH_MODEL_BASE_PATH=./checkpoints
DIFFSYNTH_SKIP_DOWNLOAD=true
WBWAM_ACTION_DIT_PATH=${DIFFSYNTH_MODEL_BASE_PATH}/ActionDiT_linear_interp_Wan22_alphascale_1024hdim.pt
WBWAM_TEXT_CACHE_ROOT=./text_embeds_cache
WBWAM_RUNS_ROOT=./runs
WBWAM_STATS_ROOT=./dataset_stats
WBWAM_PRETRAIN_CHECKPOINT=./checkpoints/wbwam/pretrain/step_037617.pt
WBWAM_MIDTRAIN_CHECKPOINT=./checkpoints/wbwam/midtrain/step_020560.pt

WBWAM_CACHE_ROOT=./cache
HF_HOME=${WBWAM_CACHE_ROOT}/huggingface
TORCH_HOME=${WBWAM_CACHE_ROOT}/torch
TRITON_CACHE_DIR=${WBWAM_CACHE_ROOT}/triton
TORCHINDUCTOR_CACHE_DIR=${WBWAM_CACHE_ROOT}/torchinductor
WANDB_DIR=./wandb
PIP_CACHE_DIR=${WBWAM_CACHE_ROOT}/pip
# Use a short writable location on your machine to avoid AF_UNIX path limits.
TMPDIR=./tmp

# Leave empty to use the active environment's libraries and nvcc on PATH.
WBWAM_CUDA_HOME_DEFAULT=
WBWAM_CUDA_CANDIDATES=
WBWAM_FFMPEG_ROOT_DEFAULT=
FFMPEG_ROOT=
WBWAM_MODULE_INIT_PATHS=
WBWAM_FONT_DIR=
HYDRA_FULL_ERROR=1
