# Copy this template to collector/humanoid_gpt/scripts/hgpt_collection.env and set values for this host.
# Shared defaults for the HumanoidGPT real-robot collection pipeline.
# Export any variable before launching a process to override its default.

HGPT_HAND_SOURCE="${HGPT_HAND_SOURCE:-manus}"
HGPT_PICO_SERVICE_MODE="${HGPT_PICO_SERVICE_MODE:-${HUMANOID_GPT_PICO_SERVICE_MODE:-external}}"
HGPT_PUBLISH_WUJI_HAND="${HGPT_PUBLISH_WUJI_HAND:-true}"
HGPT_NET="${HGPT_NET:-<ROBOT_INTERFACE>}"
HGPT_POLICY_PROVIDER="${HGPT_POLICY_PROVIDER:-tensorrt}"
HGPT_POSE_ENDPOINT="${HGPT_POSE_ENDPOINT:-tcp://127.0.0.1:5556}"
HGPT_STATE_ACTION_ENDPOINT="${HGPT_STATE_ACTION_ENDPOINT:-tcp://127.0.0.1:5558}"
HGPT_HAND_STATUS_ENDPOINT="${HGPT_HAND_STATUS_ENDPOINT:-tcp://<ROBOT_IP>:5559}"
HGPT_CAMERA_ENDPOINT="${HGPT_CAMERA_ENDPOINT:-tcp://127.0.0.1:5560}"
