# Robot-local config. Copy to head_servo.env; existing files are preserved by setup.
# Empty selects the sole CH340 1a86:7523 UART. Multiple adapters require a by-id/by-path selection.
: "${HEAD_SERIAL_DEVICE:=}"
# Default executable is collector/sonic/head/build/head_servo (compiled on the robot).
: "${HEAD_SERVO_BINARY:=}"
# Default pose: raw encoder counts, no head calibration required.
: "${HEAD_SERVO_MODE:=raw}"
: "${HEAD_JOINT0_ENCODER:=3027}"
: "${HEAD_JOINT1_ENCODER:=1849}"
# Diagnostic current-pose hold: explicitly set HEAD_SERVO_MODE=current.
