# Copy this template to collector/sonic/scripts/collector_pc.env and set values for this host.
# Fixed-topology PC launcher configuration
#
# This file is for the PC that runs:
# - tracker/sonic/gear_sonic_deploy
# - pico_manager_thread_server.py
# - collector
#
# Edit these values once, then start directly with:
#   collector/sonic/scripts/run_pico_manager.sh
#   tracker/sonic/gear_sonic_deploy/scripts/run_deploy_pc.sh
#   collector/sonic/scripts/run_collector_pc.sh

# Leave empty to prompt for task name when starting run_collector_pc.sh.
: "${TASK_NAME:=}"
# Robot camera service address used by the PC collector.
: "${CAMERA_HOST:=<ROBOT_IP>}"
: "${CAMERA_PORT:=5560}"
: "${HAND_CONTROL_MODE:=manus}"
: "${WUJI_GLOVE_LEFT_ADDRESS:=}"
: "${WUJI_GLOVE_RIGHT_ADDRESS:=}"
: "${WUJI_GLOVE_STALE_S:=0.2}"
: "${MANUS_STALE_S:=0.2}"
: "${MANUS_INIT_TIMEOUT_S:=10.0}"
: "${MANUS_MCP_JOINT:=proximal}"
: "${MANUS_DEBUG_NODE_INFO:=0}"
: "${MANUS_LOAD_CALIBRATION:=1}"
: "${MANUS_CALIBRATION_FILE:=}"
: "${MANUS_LEFT_CALIBRATION_FILE:=}"
: "${MANUS_RIGHT_CALIBRATION_FILE:=}"
: "${MANUS_LEFT_RETARGETING_CONFIG:=}"
: "${MANUS_RIGHT_RETARGETING_CONFIG:=}"
: "${DEPLOY_HAND_BACKEND:=remote_wuji_proxy}"
# Disable deploy-side teleop safety gate by default for VLA+SONIC testing.
# Set to 0 to re-enable the deploy safeguard.
: "${G1_DISABLE_TELEOP_SAFETY_GATE:=1}"
# Robot-side Wuji hand feedback service address used by the PC collector.
# Host and port are independent from the camera service.
: "${ROBOT_HAND_HOST:=${CAMERA_HOST}}"
: "${ROBOT_HAND_STATUS_PORT:=5559}"
: "${ROBOT_HAND_STATUS_ENDPOINT:=tcp://${ROBOT_HAND_HOST}:${ROBOT_HAND_STATUS_PORT}}"
: "${LEFT_WUJI_SERIAL:=}"
: "${RIGHT_WUJI_SERIAL:=}"
: "${XR_LISTEN:=0.0.0.0:13579}"
# Default topology: PICO connects to the PC over Ethernet; MANUS's USB wireless
# receiver is plugged into the PC. Camera and Wuji USB devices stay on the robot.
# Set XR_VIDEO_HOST to the verified PICO wired IP for the default setup.
# Empty falls back to the OPEN_CAMERA request IP (which may be its Wi-Fi IP).
# PICO app PC Service uses the PC's PICO-facing IP, not this headset IP.
: "${XR_VIDEO_HOST:=}"
# Hand control choices:
#   manus          - MANUS Integrated SDK glove skeleton -> MANUS retargeting qpos
#   wuji_glove     - Wuji Glove hand_skeleton -> Wuji retargeting qpos
#   gesture_wuji   - Pico hand-tracking -> Wuji retargeting qpos
#   binary_trigger - binary open/close driven by controller trigger
# Choices:
#   gst        - current PICO Camera Listen path (requires gi/GStreamer + encoder plugins)
#   psi0_image - browser-based Psi0-style image preview, no gi/GStreamer required
: "${XR_LISTEN_BACKEND:=gst}"
# Leave empty to save SONIC tracker collections under datasets/sonic.
: "${OUTPUT_ROOT:=}"
: "${RECORD_DEPTH:=1}"
: "${DEFER_DEPTH_COMPRESSION:=1}"
# collector_timer supports 20/30Hz; official_latest requires 50Hz.
# To collect at 50Hz, set both CAPTURE_FPS=50 and CAPTURE_MODE=official_latest.
: "${CAPTURE_FPS:=20}"
: "${CAPTURE_MODE:=collector_timer}"
# Leave empty for automatic mapping (50 -> 60Hz camera, otherwise same as capture).
: "${CAMERA_FPS:=}"

# Optional: override the robot network interface for deploy.sh.
# Leave as "real" to auto-detect the wired Unitree link.
: "${ROBOT_INTERFACE:=real}"

# Robot-side wuji_hand_server must subscribe to the PC pose PUB at tcp://<PC_ZMQ_HOST>:5556.
# Set the same value in collector/sonic/scripts/wuji_hand_server.env on the robot.
: "${PC_ZMQ_HOST:=<PC_IP>}"
