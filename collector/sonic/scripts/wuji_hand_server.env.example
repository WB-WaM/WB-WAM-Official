# Copy this template to collector/sonic/scripts/wuji_hand_server.env and set values for this host.
# Robot-side Wuji hand server configuration
#
# This file is for the robot machine that has the Wuji hands attached by USB.
# After editing once, start directly with:
#   collector/sonic/scripts/run_wuji_hand_server.sh

# PC address reachable from the robot. The server subscribes to pico_manager's
# pose topic at tcp://${PC_ZMQ_HOST}:5556.
: "${PC_ZMQ_HOST:=<PC_IP>}"

# Must match ROBOT_HAND_STATUS_PORT in collector_pc.env.
: "${WUJI_HAND_STATUS_PORT:=5559}"
: "${WUJI_HAND_STATUS_BIND:=tcp://0.0.0.0:${WUJI_HAND_STATUS_PORT}}"
: "${LEFT_WUJI_SERIAL:=}"
: "${RIGHT_WUJI_SERIAL:=}"
: "${WUJI_HAND_DRY_RUN:=0}"
: "${WUJI_HAND_LOG_LEVEL:=INFO}"
