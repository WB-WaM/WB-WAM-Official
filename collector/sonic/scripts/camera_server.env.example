# Copy this template to collector/sonic/scripts/camera_server.env and set values for this host.
# Fixed-topology robot camera host configuration
#
# This file is for the robot machine that has the RealSense cameras attached.
# After editing once, start directly with:
#   collector/sonic/scripts/run_camera_server.sh --head-motion-approved

# Must match CAMERA_PORT in collector_pc.env.
: "${CAMERA_BIND_PORT:=5560}"
: "${CAMERA_BIND:=tcp://0.0.0.0:${CAMERA_BIND_PORT}}"
: "${WIDTH:=640}"
: "${HEIGHT:=480}"
# Physical camera FPS is independent from the dataset rate. The official_latest
# 50Hz collector consumes this 60Hz source causally; timer flows may override it.
: "${CAMERA_FPS:=}"
: "${JPEG_QUALITY:=80}"

# Deployment/collection camera startup supervises the head servo hold service.
# run_camera_server.sh --head-motion-approved holds the configured encoder pose (default joint0=3027, joint1=1849; no calibration).
: "${HEAD_SERVO_ENABLED:=1}"
# Optional robot-local override; default is scripts/head_servo.env.
: "${HEAD_SERVO_CONFIG_FILE:=}"
